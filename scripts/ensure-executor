#!/usr/bin/env bash
# What one alderd wake runs: `driver.json`'s `command`.
#
# Policy (operator-ratified): a resident executor with semi-frequent
# rotation. The current executor's handle lives in `.alder/executor-handle`
# (machine-local, like every other `.alder/` file); each wake:
#
#   1. runs `alder refresh` — the observation sweep belongs to this command
#      now, so status reflects live executions before anything reads it;
#   2. ensures one executor session exists and delivers the wake to it:
#        no handle, or its status is dead    -> start a fresh executor;
#        alive but older than the rotation
#        age, a negative age (the clock
#        rolled back under the note), or a
#        durable rotation request is
#        outstanding                         -> kill it, start fresh;
#        otherwise                           -> send one line naming the
#                                               triggers ($ALDERD_TRIGGERS).
#
# The runner's exit codes are the contract this script branches on, never its
# prose. For `send`: 0 delivered; 4 means another operation holds the handle
# lock — another wake is delivering, so this one stands down without killing
# anything; 5 means the executor cannot receive the wake (a `done`
# interactive engine, a torn pane) and the session is rotated. For `start`:
# 0 started (stdout: the handle, then `tier <served>`); 3 means a live
# executor already runs — adopt the handle from the `handle <h>` stdout line;
# 4 means another wake is starting one — stand down.
#
# The notes file is written atomically (tmp+mv), and the honored-rotate-seq
# it carries is advanced ONLY on a kill+start: an adopted executor never
# consumes a rotation request, because nothing rotated.
#
# Branch discipline (documented decision): the executor sits in a runner-cut
# worktree beside the primary checkout on the branch named by
# $ALDER_EXECUTOR_BRANCH (default `executor`). That branch carries no
# commits of its own — it is a seat, not a line of work — and each fresh
# executor's first instruction is `git merge --ff-only main`, which
# fast-forwards the seat to current main. Merges to main cannot happen in
# that worktree (main stays checked out in the primary checkout, and git
# allows a branch in only one worktree), so the executor performs them in
# the primary checkout with `git -C <primary-root>`, and pushes main from
# there; PASS.md states the same rule from the executor's side.
#
# Tunables, all environment: ALDER_EXECUTOR_TIER (default `fable`),
# ALDER_EXECUTOR_BRANCH (default `executor`),
# ALDER_EXECUTOR_ROTATION_SECONDS (default 21600 — six hours).
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd -P)
root=$(dirname "$(git -C "$script_dir" rev-parse --path-format=absolute --git-common-dir)")
cd "$root"

resolve_bin() {
  name=$1
  override=$2
  if [ -n "$override" ]; then
    printf '%s\n' "$override"
    return 0
  fi
  for candidate in "$root/target/release/$name" "$root/target/debug/$name"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  echo "ensure-executor: $name not found; build it or set ${3}" >&2
  return 1
}
alder=$(resolve_bin alder "${ALDER_BIN:-}" ALDER_BIN)
runner=$(resolve_bin alder-ext-runner "${ALDER_EXT_RUNNER_BIN:-}" ALDER_EXT_RUNNER_BIN)

tier=${ALDER_EXECUTOR_TIER:-fable}
branch=${ALDER_EXECUTOR_BRANCH:-executor}
rotation=${ALDER_EXECUTOR_ROTATION_SECONDS:-21600}
triggers=${ALDERD_TRIGGERS:-none}
notes=$root/.alder/executor-handle

scratch=$(mktemp -d "${TMPDIR:-/tmp}/alder-ensure-executor.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

# 1. The observation sweep, before anything reads status. A failing sweep
# fails the wake — alderd retries next poll — because acting on a stale
# picture is worse than acting late.
"$alder" refresh

# The durable rotation request, honored by the note-comparison rule LOOP.md
# states: a request sequence later than the noted one is outstanding, and
# rotating (which notes it) consumes it.
rotate_seq=$("$alder" status --json |
  sed -n 's/.*"rotate_requested_seq":\([0-9][0-9]*\).*/\1/p')
rotate_seq=${rotate_seq:-0}

handle=""
started=0
noted_rotate=0
if [ -f "$notes" ]; then
  {
    read -r handle || true
    read -r started || true
    read -r noted_rotate || true
  } <"$notes"
fi
# Corrupt notes read as ancient, which rotates — the safe direction.
case $started in '' | *[!0-9]*) started=0 ;; esac
case $noted_rotate in '' | *[!0-9]*) noted_rotate=0 ;; esac

# The file a later wake decides from, written whole or not at all: a wake
# killed mid-write must never leave a torn note that misidentifies the
# executor. The honored rotate seq is the caller's to choose — only a
# kill+start passes the current request seq; adoption passes the old one.
note() { # note <handle> <honored-rotate-seq>
  printf '%s\n%s\n%s\n' "$1" "$(date +%s)" "$2" >"$notes.tmp.$$"
  mv -f "$notes.tmp.$$" "$notes"
}

deliver() { # deliver <handle> — one line naming the triggers
  printf '%s\n' \
    "Read the current Alder state and act on it. Your brief is PASS.md. Triggers this wake: $triggers." \
    >"$scratch/wake"
  "$runner" send "$1" --file "$scratch/wake"
}

# Deliver the wake and act on the send contract: 0 delivered, 4 another wake
# delivered (stand down, never kill), 5 the executor cannot receive (rotate
# when allowed — killing an executor over a transient failure is not this
# script's call for any other code).
deliver_or_rotate() { # deliver_or_rotate <handle> <rotate|no-rotate>
  local handle=$1 may_rotate=$2 sent=0
  deliver "$handle" || sent=$?
  case $sent in
  0)
    echo "ensure-executor: delivered wake to $handle"
    exit 0
    ;;
  4)
    echo "ensure-executor: another wake delivered to $handle; standing down"
    exit 0
    ;;
  5)
    if [ "$may_rotate" = rotate ]; then
      echo "ensure-executor: $handle cannot receive the wake; rotating" >&2
      "$runner" kill "$handle"
      start_fresh "$rotate_seq" no-adopt
    else
      echo "ensure-executor: the adopted executor $handle cannot receive the wake; leaving it to the next wake" >&2
      exit 1
    fi
    ;;
  *)
    echo "ensure-executor: send to $handle failed (exit $sent); failing this wake" >&2
    exit 1
    ;;
  esac
}

# Start a fresh executor. The runner seeds the worktree's log configuration
# before the engine starts (--seed), so a fast engine can never read an
# unseeded worktree. `note_seq` is the honored-rotate-seq the fresh note
# records: the current request seq on a kill+start, the previous one
# everywhere else.
start_fresh() { # start_fresh <note-seq> <adopt|no-adopt>
  local note_seq=$1 may_adopt=$2 status=0
  printf '%s\n' \
    "You are the alder executor. First fast-forward this worktree to current" \
    "main: git merge --ff-only main (your seat branch $branch carries no commits" \
    "of its own). Then build the CLI (cargo build) and read PASS.md at the" \
    "worktree root — it is your entire brief. Read the current Alder state and" \
    "act on it. Triggers this wake: $triggers." \
    >"$scratch/prompt"
  set +e
  "$runner" start --repo "$root" --branch "$branch" --tier "$tier" \
    --prompt-file "$scratch/prompt" \
    --seed "$root/.alder/config.json:.alder/config.json" \
    >"$scratch/start-out" 2>"$scratch/start-err"
  status=$?
  set -e
  cat "$scratch/start-err" >&2 || true
  case $status in
  0)
    handle=$(sed -n 1p "$scratch/start-out")
    note "$handle" "$note_seq"
    echo "ensure-executor: started $handle"
    exit 0
    ;;
  3)
    # A live session these notes had no record of: adopt it and deliver the
    # wake to it instead. Its age is unknown, so the note starts it now —
    # rotation arrives at most one rotation age late, which is harmless —
    # and the honored seq stays put: an adopt never consumes a rotation
    # request, because nothing rotated.
    handle=$(sed -n '1s/^handle //p' "$scratch/start-out")
    if [ -z "$handle" ]; then
      echo "ensure-executor: the runner refused with exit 3 but printed no handle line" >&2
      exit 1
    fi
    if [ "$may_adopt" != adopt ]; then
      echo "ensure-executor: a live executor reappeared mid-rotation; leaving it to the next wake" >&2
      exit 1
    fi
    echo "ensure-executor: adopting live executor $handle"
    note "$handle" "$noted_rotate"
    deliver_or_rotate "$handle" no-rotate
    ;;
  4)
    echo "ensure-executor: another wake is starting the executor; standing down"
    exit 0
    ;;
  *)
    cat "$scratch/start-out" >&2 || true
    echo "ensure-executor: the runner could not start an executor (exit $status)" >&2
    exit 1
    ;;
  esac
}

action=start
if [ -n "$handle" ]; then
  # Captured to a file, not piped through `head`: a reader that quits after
  # the first line SIGPIPEs the runner's second, and pipefail would then
  # fail the wake on a perfectly good status.
  "$runner" status "$handle" >"$scratch/status"
  word=$(sed -n 1p "$scratch/status")
  age=$(($(date +%s) - started))
  case $word in
  running | done)
    if [ "$rotate_seq" -gt "$noted_rotate" ]; then
      echo "ensure-executor: rotation requested (seq $rotate_seq); rotating $handle"
      action=rotate
    elif [ "$age" -lt 0 ]; then
      # The note claims a start in the future: the clock rolled back under
      # it. An unknowable age is treated as ancient — the safe direction.
      echo "ensure-executor: $handle claims a future start (clock rollback); rotating"
      action=rotate
    elif [ "$age" -ge "$rotation" ]; then
      echo "ensure-executor: $handle is ${age}s old (limit ${rotation}s); rotating"
      action=rotate
    else
      action=send
    fi
    ;;
  *)
    action=start
    ;;
  esac
fi

if [ "$action" = send ]; then
  # A `done` executor (engine exited, holding shell remains) gets the send
  # first: for a one-shot engine that IS the resume path. An exit-5 refusal
  # — an exited interactive engine, a torn pane — rotates instead.
  deliver_or_rotate "$handle" rotate
fi

if [ "$action" = rotate ]; then
  "$runner" kill "$handle"
  # The kill+start path is the one place the honored seq advances: this is
  # what consumes an outstanding rotation request.
  start_fresh "$rotate_seq" adopt
fi

start_fresh "$noted_rotate" adopt
