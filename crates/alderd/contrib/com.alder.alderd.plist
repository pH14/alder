<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for scripts/alderd-install.sh. The @...@ values are replaced with
  absolute paths for this checkout before launchd sees the file.

  alderd runs one project. Use one copy per project, with a distinct Label,
  and give each project a distinct tmuxSession in its .alder/driver.json.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alder.alderd</string>

    <key>ProgramArguments</key>
    <array>
        <string>@ALDERD_BIN@</string>
        <string>--root</string>
        <string>@REPO_ROOT@</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <!-- alderd shells out to alder, git, and tmux, so they must be on PATH. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
        <key>ALDER_ACTOR</key>
        <string>alderd</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- The daemon paces itself; do not let launchd throttle a restart loop
         faster than one poll interval. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>@REPO_ROOT@/.alder/alderd.log</string>
    <key>StandardErrorPath</key>
    <string>@REPO_ROOT@/.alder/alderd.log</string>

    <!-- alderd wakes an interactive agent; it has no business running when
         nobody is logged in. LimitLoadToSessionType keeps it in the GUI
         session where its tmux server lives. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
